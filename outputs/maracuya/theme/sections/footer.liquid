<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} — inicio">
        <img src="{{ 'maracuya-logo-inverso.svg' | asset_url }}" width="230" height="48" alt="{{ shop.name }}" style="height:42px;width:auto">
      </a>
      {%- if section.settings.tagline != blank -%}
        <p>{{ section.settings.tagline }}</p>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'menu' and block.settings.menu != blank -%}
        <div class="footer-col" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          <ul>
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <div class="footer-col">
      <h4>Ayuda</h4>
      <ul>
        {%- if shop.privacy_policy != blank -%}
          <li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>
        {%- endif -%}
        {%- if shop.terms_of_service != blank -%}
          <li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>
        {%- endif -%}
        {%- if shop.refund_policy != blank -%}
          <li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>
        {%- endif -%}
        {%- if shop.shipping_policy != blank -%}
          <li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>
        {%- endif -%}
      </ul>
    </div>
  </div>

  {%- if section.settings.notice != blank -%}
    <div class="container">
      <div class="footer-demo-notice">
        {% render 'brand-icon', name: 'alert-triangle', size: 18 %}
        <span>{{ section.settings.notice }}</span>
      </div>
    </div>
  {%- endif -%}

  <div class="container footer-bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span>{{ shop.email }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Texto de marca",
      "default": "Raíces latinas. Sabor de casa. Productos de Latinoamérica para el mercado español."
    },
    {
      "type": "textarea",
      "id": "notice",
      "label": "Aviso destacado",
      "info": "Útil mientras la tienda no esté operativa. Déjalo vacío para ocultarlo."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Columna de enlaces",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Comprar" },
        { "type": "link_list", "id": "menu", "label": "Menú" }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
