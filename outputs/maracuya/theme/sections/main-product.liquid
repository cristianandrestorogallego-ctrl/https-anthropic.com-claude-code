{%- liquid
  assign v = product.selected_or_first_available_variant
  assign on_sale = false
  if v.compare_at_price > v.price
    assign on_sale = true
  endif
-%}

<div class="container" style="padding-block:var(--sp-7)">
  <nav class="breadcrumbs" aria-label="Ruta de navegación">
    <a href="{{ routes.root_url }}">Inicio</a>
    <span class="sep">/</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a><span class="sep">/</span>
    {%- endif -%}
    <span aria-current="page">{{ product.title }}</span>
  </nav>

  <div class="detail-layout">
    <div>
      <div class="gallery-main{% unless product.featured_image %} media-placeholder{% endunless %}">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 1000 }}"
               alt="{{ product.featured_image.alt | default: product.title | escape }}"
               width="1000" height="1000"
               style="width:100%;height:100%;object-fit:cover;border-radius:inherit">
        {%- else -%}
          {% render 'brand-icon', name: 'bag', size: 96 %}
        {%- endif -%}
      </div>
    </div>

    <div>
      <div class="detail-badges">
        {%- if product.vendor != blank -%}
          <span class="badge badge-country">{{ product.vendor }}</span>
        {%- endif -%}
        {%- if product.available -%}
          <span class="badge badge-stock-in">{{ 'products.available' | t }}</span>
        {%- else -%}
          <span class="badge badge-stock-out">{{ 'products.sold_out' | t }}</span>
        {%- endif -%}
      </div>

      <h1 style="font-size:clamp(1.6rem,3.4vw,2.4rem);letter-spacing:-.018em;margin-block:10px">{{ product.title }}</h1>

      <div class="product-card__price-line" data-variant-price style="margin-block:var(--sp-4)">
        <span class="price" style="font-size:1.6rem">{{ v.price | money }}</span>
        {%- if on_sale -%}
          <span class="price-old">{{ v.compare_at_price | money }}</span>
          {%- assign pct = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round -%}
          <span class="price-discount">-{{ pct }}%</span>
        {%- endif -%}
      </div>

      {%- form 'product', product -%}
        <input type="hidden" name="id" value="{{ v.id }}">

        {%- unless product.has_only_default_variant -%}
          <div class="variant-picker">
            {%- for option in product.options_with_values -%}
              <div class="variant-picker__row">
                <label class="field" for="option-{{ forloop.index }}">
                  <span>{{ option.name }}</span>
                  <select id="option-{{ forloop.index }}" data-variant-select name="options[{{ option.name | escape }}]">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </label>
              </div>
            {%- endfor -%}
          </div>

          <script type="application/json" data-variant-data>
            [
              {%- for variant in product.variants -%}
                {
                  "id": {{ variant.id }},
                  "options": {{ variant.options | json }},
                  "available": {{ variant.available }},
                  "price_html": {{ variant.price | money | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          </script>
        {%- endunless -%}

        <div class="field" style="max-width:160px">
          <label for="quantity">{{ 'products.quantity' | t }}</label>
          <input type="number" id="quantity" name="quantity" value="1" min="1" inputmode="numeric">
        </div>

        <button class="btn btn-primary btn-block" type="submit"
                data-label-available="{{ 'products.add_to_cart' | t }}"
                data-label-sold-out="{{ 'products.sold_out' | t }}"
                {% unless product.available %}disabled{% endunless %}>
          {%- if product.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
        </button>

        {{ form | payment_button }}
      {%- endform -%}

      {%- if settings.whatsapp_number != blank -%}
        {%- capture wa_text -%}Hola {{ shop.name }}, quiero preguntar por: {{ product.title }} — {{ shop.url }}{{ product.url }}{%- endcapture -%}
        <a class="btn btn-whatsapp btn-block" style="margin-top:12px"
           href="https://wa.me/{{ settings.whatsapp_number }}?text={{ wa_text | url_encode }}"
           target="_blank" rel="noopener noreferrer">
          {% render 'brand-icon', name: 'whatsapp', size: 16 %} Preguntar por WhatsApp
        </a>
        {%- if settings.whatsapp_note != blank -%}
          <p class="offer-example-note">{{ settings.whatsapp_note }}</p>
        {%- endif -%}
      {%- endif -%}

      <div class="rte" style="margin-top:var(--sp-6)">
        {%- if product.description != blank -%}
          {{ product.description }}
        {%- else -%}
          <p class="pending-note">{% render 'brand-icon', name: 'alert-triangle', size: 14 %} {{ 'products.no_description' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Producto",
  "tag": "section",
  "settings": []
}
{% endschema %}
