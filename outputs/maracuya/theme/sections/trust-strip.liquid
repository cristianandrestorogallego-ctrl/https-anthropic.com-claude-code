<section class="section section-deep">
  <div class="container">
    {%- if section.blocks.size > 0 -%}
      <div class="feature-grid">
        {%- for block in section.blocks -%}
          <div class="feature-card" {{ block.shopify_attributes }}>
            <span class="feature-card__icon">{% render 'brand-icon', name: block.settings.icon, size: 22 %}</span>
            <div>
              <h3>{{ block.settings.heading }}</h3>
              {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_payment_icons -%}
      <div class="payment-methods">
        {%- for type in shop.enabled_payment_types -%}
          <span class="payment-chip">{{ type | payment_type_svg_tag: class: 'payment-icon' }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Franja de confianza",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_payment_icons", "label": "Mostrar métodos de pago activos", "default": true, "info": "Muestra únicamente los métodos realmente activados en Configuración → Pagos." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ventaja",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Envío" },
            { "value": "headset", "label": "Atención" },
            { "value": "shield-check", "label": "Pago seguro" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "tag", "label": "Ofertas" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Título", "default": "Envío a toda España" },
        { "type": "textarea", "id": "body", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Franja de confianza",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "heading": "Envío a España peninsular" } },
        { "type": "item", "settings": { "icon": "headset", "heading": "Atención cercana" } },
        { "type": "item", "settings": { "icon": "shield-check", "heading": "Pago seguro" } }
      ]
    }
  ]
}
{% endschema %}
