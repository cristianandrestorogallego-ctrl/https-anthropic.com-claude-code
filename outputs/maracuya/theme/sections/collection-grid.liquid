<section class="section{% if section.settings.tinted %} section-alt{% endif %}">
  <div class="container">
    <div class="section-header">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.link != blank -%}
        <a class="section-link" href="{{ section.settings.link }}">
          {{ section.settings.link_label | default: 'Ver todo' }} {% render 'brand-icon', name: 'arrow-right', size: 14 %}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="category-grid">
        {%- for block in section.blocks -%}
          {%- assign col = block.settings.collection -%}
          {%- if col != blank -%}
            <a class="category-card" href="{{ col.url }}" {{ block.shopify_attributes }}>
              <span class="category-card__media tile-{{ block.settings.tile }}">
                {%- if col.featured_image -%}
                  <img src="{{ col.featured_image | image_url: width: 500 }}" alt=""
                       width="500" height="375" loading="lazy"
                       style="width:100%;height:100%;object-fit:cover;border-radius:inherit">
                {%- else -%}
                  {% render 'brand-icon', name: 'bag', size: 48 %}
                {%- endif -%}
              </span>
              <strong>{{ block.settings.label | default: col.title }}</strong>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-state">
        {% render 'brand-icon', name: 'bag', size: 40 %}
        <h3>{{ 'onboarding.no_collections_title' | t }}</h3>
        <p>{{ 'onboarding.no_collections_body' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rejilla de colecciones",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Categorías" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Todo lo que necesitas para cocinar y disfrutar." },
    { "type": "url", "id": "link", "label": "Enlace de la cabecera" },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver todo" },
    { "type": "checkbox", "id": "tinted", "label": "Fondo tintado", "default": false }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Colección",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "label", "label": "Etiqueta", "info": "Si lo dejas vacío se usa el nombre de la colección." },
        {
          "type": "select",
          "id": "tile",
          "label": "Color",
          "default": "despensa",
          "options": [
            { "value": "bebidas", "label": "Bebidas" },
            { "value": "snacks", "label": "Snacks" },
            { "value": "dulces", "label": "Dulces" },
            { "value": "despensa", "label": "Despensa" },
            { "value": "salsas", "label": "Salsas" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rejilla de colecciones",
      "blocks": [
        { "type": "item", "settings": { "tile": "bebidas" } },
        { "type": "item", "settings": { "tile": "snacks" } },
        { "type": "item", "settings": { "tile": "dulces" } },
        { "type": "item", "settings": { "tile": "despensa" } },
        { "type": "item", "settings": { "tile": "salsas" } }
      ]
    }
  ]
}
{% endschema %}
