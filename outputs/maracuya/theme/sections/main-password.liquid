<div class="password-page">
  <div class="password-card">
    <a class="password-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if settings.logo_dark != blank -%}
        <img src="{{ settings.logo_dark | image_url: width: 520 }}" width="{{ settings.logo_dark.width }}" height="{{ settings.logo_dark.height }}" alt="{{ shop.name }}">
      {%- else -%}
        <img src="{{ 'maracuya-logo-inverso.svg' | asset_url }}" width="230" height="48" alt="{{ shop.name }}">
      {%- endif -%}
    </a>

    {%- if section.settings.heading != blank -%}
      <h1 class="password-heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- unless shop.password_message == blank -%}
      <div class="rte password-message">{{ shop.password_message }}</div>
    {%- endunless -%}

    {%- if section.settings.show_signup -%}
      <div class="password-block">
        <h2 class="password-block__title">{{ 'password.signup_title' | t }}</h2>
        {%- form 'customer' -%}
          {%- if form.posted_successfully? -%}
            <p class="password-success">{{ 'password.signup_success' | t }}</p>
          {%- else -%}
            {{ form.errors | default_errors }}
            <input type="hidden" name="contact[tags]" value="prospect, password page">
            <div class="field">
              <label for="password-email">{{ 'password.email_label' | t }}</label>
              <input class="text-input" type="email" id="password-email" name="contact[email]"
                     autocomplete="email" placeholder="{{ 'password.email_placeholder' | t }}" required>
            </div>
            <button class="btn btn-primary btn-block" type="submit">{{ 'password.signup_submit' | t }}</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    <div class="password-block">
      <h2 class="password-block__title">{{ 'password.owner_title' | t }}</h2>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <div class="field">
          <label for="storefront-password">{{ 'password.password_label' | t }}</label>
          <input class="text-input" type="password" id="storefront-password" name="password"
                 autocomplete="current-password" required>
        </div>
        <button class="btn btn-secondary btn-block" type="submit">{{ 'password.password_submit' | t }}</button>
      {%- endform -%}
    </div>

    <p class="password-note">{{ 'password.note' | t }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Página de contraseña",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Estamos preparando la tienda" },
    { "type": "checkbox", "id": "show_signup", "label": "Mostrar registro por correo", "default": true, "info": "Los correos se guardan como clientes con las etiquetas «prospect, password page»." }
  ]
}
{% endschema %}
