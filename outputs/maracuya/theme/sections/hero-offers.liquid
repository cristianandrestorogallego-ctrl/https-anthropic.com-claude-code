{%- comment -%}
  Hero carousel. Each block is one slide, editable in the theme editor: pick a
  collection or a product, write the copy, choose the tile hue. When a slide
  has no image the branded 3D render stands in, so the hero never shows an
  empty frame while product photography is still pending.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
<section class="hero-carousel" data-carousel data-current="0"
         aria-roledescription="carrusel" aria-label="{{ section.settings.heading | default: 'Destacados' }}">
  {%- for block in section.blocks -%}
    {%- liquid
      assign product = block.settings.product
      assign heading = block.settings.heading
      assign body = block.settings.body
      if heading == blank and product != blank
        assign heading = product.title
      endif
      if body == blank and product != blank
        assign body = product.description | strip_html | truncate: 150
      endif
      assign link = block.settings.link
      if link == blank and product != blank
        assign link = product.url
      endif
    -%}
    <div class="hero-slide tile-{{ block.settings.tile }}" data-slide {% unless forloop.first %}hidden{% endunless %}
         {{ block.shopify_attributes }}>
      <div class="hero-slide__stage" aria-hidden="true">
        {%- if product != blank and product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 900 }}"
               alt="" width="900" height="900"
               style="height:92%;width:auto;max-height:460px;object-fit:contain;filter:drop-shadow(0 26px 30px rgba(20,10,24,.45))">
        {%- else -%}
          {% render 'product-3d', shape: block.settings.shape, uid: block.id %}
        {%- endif -%}
      </div>
      <div class="hero-slide__scrim" aria-hidden="true"></div>

      <div class="hero-slide__content">
        {%- if block.settings.badge != blank -%}
          <div class="hero-slide__badges">
            <span class="hero-badge">{% render 'brand-icon', name: 'tag', size: 14 %} {{ block.settings.badge }}</span>
            {%- if product != blank and product.compare_at_price > product.price -%}
              {%- assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
              <span class="hero-discount">-{{ pct }}%</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if heading != blank -%}<h2 class="hero-slide__title">{{ heading }}</h2>{%- endif -%}
        {%- if body != blank -%}<p class="hero-slide__desc">{{ body }}</p>{%- endif -%}

        <div class="hero-ctas">
          {%- if link != blank -%}
            <a class="btn btn-primary" href="{{ link }}">
              {{ block.settings.cta | default: 'Ver producto' }} {% render 'brand-icon', name: 'arrow-right', size: 16 %}
            </a>
          {%- endif -%}
          {%- if block.settings.link_secondary != blank -%}
            <a class="btn btn-secondary" href="{{ block.settings.link_secondary }}">
              {{ block.settings.cta_secondary | default: 'Ver todo' }}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="hero-carousel__controls">
          <button class="hero-carousel__arrow is-prev" type="button" data-slide-prev
                  aria-label="Anterior" style="transform:scaleX(-1)">
            {% render 'brand-icon', name: 'chevron-right', size: 18 %}
          </button>
          <div class="hero-carousel__dots">
            {%- for b in section.blocks -%}
              <button class="hero-carousel__dot{% if forloop.first %} is-active{% endif %}" type="button"
                      data-slide-dot="{{ forloop.index0 }}"
                      aria-label="Ir a la diapositiva {{ forloop.index }} de {{ section.blocks.size }}"></button>
            {%- endfor -%}
          </div>
          <button class="hero-carousel__arrow is-next" type="button" data-slide-next aria-label="Siguiente">
            {% render 'brand-icon', name: 'chevron-right', size: 18 %}
          </button>
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Hero de destacados",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nombre del carrusel (accesibilidad)", "default": "Destacados" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto", "info": "Si lo eliges, el título, el texto y el descuento se toman del producto." },
        { "type": "text", "id": "badge", "label": "Etiqueta", "default": "Destacado" },
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "textarea", "id": "body", "label": "Texto" },
        { "type": "url", "id": "link", "label": "Enlace principal" },
        { "type": "text", "id": "cta", "label": "Botón principal", "default": "Ver producto" },
        { "type": "url", "id": "link_secondary", "label": "Enlace secundario" },
        { "type": "text", "id": "cta_secondary", "label": "Botón secundario", "default": "Ver todo" },
        {
          "type": "select",
          "id": "tile",
          "label": "Color de fondo",
          "default": "salsas",
          "options": [
            { "value": "bebidas", "label": "Bebidas (amarillo y verde)" },
            { "value": "snacks", "label": "Snacks (morado)" },
            { "value": "dulces", "label": "Dulces (dorado)" },
            { "value": "despensa", "label": "Despensa (verde)" },
            { "value": "salsas", "label": "Salsas (morado profundo)" }
          ]
        },
        {
          "type": "select",
          "id": "shape",
          "label": "Envase de reserva",
          "info": "Se usa solo cuando el producto no tiene foto.",
          "default": "jar",
          "options": [
            { "value": "jar", "label": "Tarro" },
            { "value": "bag", "label": "Bolsa" },
            { "value": "box", "label": "Estuche" },
            { "value": "bottle", "label": "Botella" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero de destacados",
      "blocks": [
        { "type": "slide", "settings": { "tile": "dulces", "shape": "box", "badge": "Destacado" } },
        { "type": "slide", "settings": { "tile": "despensa", "shape": "bag", "badge": "Destacado" } },
        { "type": "slide", "settings": { "tile": "salsas", "shape": "jar", "badge": "Destacado" } }
      ]
    }
  ]
}
{% endschema %}
