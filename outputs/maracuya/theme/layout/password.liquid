<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {{ 'maracuya.css' | asset_url | stylesheet_tag }}
    <style>
      :root{
        --primary: {{ settings.color_primary }};
        --primary-deep: {{ settings.color_primary_deep }};
        --accent: {{ settings.color_accent }};
        --leaf: {{ settings.color_leaf }};
        --bg: {{ settings.color_bg }};
        --surface: {{ settings.color_surface }};
        --ink: {{ settings.color_ink }};
      }
    </style>
  </head>

  <body class="template-password">
    <a class="skip-link" href="#main-content">{{ 'general.skip_to_content' | t }}</a>
    <main id="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
