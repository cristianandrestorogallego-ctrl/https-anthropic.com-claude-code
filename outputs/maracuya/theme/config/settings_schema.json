[
  {
    "name": "theme_info",
    "theme_name": "MARACUYA mercado latino",
    "theme_version": "0.1.0",
    "theme_author": "MARACUYA",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://shopify.dev/docs/storefronts/themes"
  },
  {
    "name": "Marca",
    "settings": [
      {
        "type": "header",
        "content": "Logotipos"
      },
      {
        "type": "paragraph",
        "content": "El tema incluye los logotipos oficiales. Súbelos aquí solo si quieres reemplazarlos."
      },
      {
        "type": "image_picker",
        "id": "logo_light",
        "label": "Logotipo sobre fondo claro"
      },
      {
        "type": "image_picker",
        "id": "logo_dark",
        "label": "Logotipo sobre fondo oscuro"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Altura del logotipo",
        "min": 24,
        "max": 72,
        "step": 2,
        "unit": "px",
        "default": 46
      }
    ]
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "paragraph",
        "content": "Estos son los colores del kit de marca. Cámbialos solo si la marca cambia."
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Morado de marca",
        "default": "#4B204F"
      },
      {
        "type": "color",
        "id": "color_primary_deep",
        "label": "Morado profundo (barra de aviso)",
        "default": "#35163A"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Amarillo de marca",
        "default": "#F4C542"
      },
      {
        "type": "color",
        "id": "color_leaf",
        "label": "Verde (recetas y paquetes)",
        "default": "#456B50"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Fondo de página",
        "default": "#FFF8EC"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Fondo de tarjetas",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Texto principal",
        "default": "#302536"
      }
    ]
  },
  {
    "name": "Redes sociales",
    "settings": [
      {
        "type": "paragraph",
        "content": "Los iconos aparecen en la cabecera solo cuando rellenas su enlace. Deja en blanco los que no uses."
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube"
      }
    ]
  },
  {
    "name": "Contacto",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "Número de WhatsApp",
        "info": "En formato internacional sin espacios ni signos, por ejemplo 34600111222. Si lo dejas vacío, el botón de WhatsApp no aparece."
      },
      {
        "type": "textarea",
        "id": "whatsapp_note",
        "label": "Aviso sobre los pedidos por WhatsApp",
        "default": "El mensaje de WhatsApp es una solicitud: no confirma el pedido, no reserva stock ni acredita el pago."
      }
    ]
  },
  {
    "name": "Productos",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Mostrar la marca del producto en las tarjetas",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_availability",
        "label": "Mostrar disponibilidad en las tarjetas",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_quick_add",
        "label": "Botón de añadir al carrito en las tarjetas",
        "default": true
      }
    ]
  }
]
