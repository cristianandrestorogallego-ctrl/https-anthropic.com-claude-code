{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ 'gift_card.title' | t }} · {{ shop.name }}</title>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48 }}">
    {%- endif -%}
    {{ content_for_header }}
    {{ 'maracuya.css' | asset_url | stylesheet_tag }}
    <style>
      :root{
        --primary: {{ settings.color_primary }};
        --primary-deep: {{ settings.color_primary_deep }};
        --accent: {{ settings.color_accent }};
        --leaf: {{ settings.color_leaf }};
        --bg: {{ settings.color_bg }};
        --surface: {{ settings.color_surface }};
        --ink: {{ settings.color_ink }};
      }
      @media print{
        .giftcard-actions{ display:none; }
        body{ background:#fff; }
      }
    </style>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  </head>

  <body class="template-gift-card">
    <main class="giftcard-page" id="main-content">
      <div class="giftcard">
        <img class="giftcard__logo" src="{{ 'maracuya-logo-inverso.svg' | asset_url }}" width="230" height="48" alt="{{ shop.name }}">

        <p class="giftcard__label">{{ 'gift_card.subtitle' | t }}</p>
        <p class="giftcard__balance tabular">{{ gift_card.balance | money }}</p>

        {%- if gift_card.balance != gift_card.initial_value -%}
          {%- assign initial_value = gift_card.initial_value | money -%}
          <p class="giftcard__initial">{{ 'gift_card.initial_value' | t: value: initial_value }}</p>
        {%- endif -%}

        {%- if gift_card.expired or gift_card.enabled == false -%}
          <p class="giftcard__expired">{{ 'gift_card.expired' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expiry_date = gift_card.expires_on | date: '%-d %B %Y' -%}
          <p class="giftcard__expiry">{{ 'gift_card.expires_on' | t: date: expiry_date }}</p>
        {%- endif -%}

        <div class="giftcard__qr" id="giftcard-qr"></div>

        <p class="giftcard__code-label">{{ 'gift_card.code_label' | t }}</p>
        <p class="giftcard__code tabular">{{ gift_card.code }}</p>

        <div class="giftcard-actions">
          <a class="btn btn-primary" href="{{ shop.url }}">{{ 'gift_card.shop_link' | t }}</a>
          <button class="btn btn-secondary" type="button" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
        </div>
      </div>
    </main>

    <script>
      // The QR library is deferred, so it is ready by DOMContentLoaded.
      document.addEventListener('DOMContentLoaded', function () {
        var mount = document.getElementById('giftcard-qr');
        if (!mount || typeof QRCode === 'undefined') return;
        new QRCode(mount, { text: {{ gift_card.qr_identifier | json }}, width: 140, height: 140 });
      });
    </script>
  </body>
</html>
