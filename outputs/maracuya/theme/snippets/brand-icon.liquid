{%- comment -%}
  One drawn icon system, one stroke weight. Never an emoji or a unicode glyph.
  Usage: {% render 'brand-icon', name: 'cart', size: 22 %}
{%- endcomment -%}
{%- liquid
  assign s = size | default: 20
-%}
<svg class="i" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
    {%- when 'cart' -%}<circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3h2l2.4 12.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.6L21 8H6"/>
    {%- when 'close' -%}<line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/>
    {%- when 'chevron-down' -%}<polyline points="6 9 12 15 18 9"/>
    {%- when 'chevron-right' -%}<polyline points="9 6 15 12 9 18"/>
    {%- when 'arrow-right' -%}<line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/>
    {%- when 'check' -%}<polyline points="20 6 9 17 4 12"/>
    {%- when 'plus' -%}<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
    {%- when 'minus' -%}<line x1="5" y1="12" x2="19" y2="12"/>
    {%- when 'truck' -%}<rect x="1" y="7" width="13" height="10" rx="1"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="6" cy="19" r="1.6"/><circle cx="17.5" cy="19" r="1.6"/>
    {%- when 'shield-check' -%}<path d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3z"/><polyline points="9 12 11.5 14.5 15.5 10"/>
    {%- when 'headset' -%}<path d="M4 13a8 8 0 0 1 16 0"/><rect x="2.5" y="13" width="4" height="6" rx="1.5"/><rect x="17.5" y="13" width="4" height="6" rx="1.5"/><path d="M20 19v1a3 3 0 0 1-3 3h-3"/>
    {%- when 'whatsapp' -%}<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    {%- when 'tag' -%}<path d="M3 12 12 3h7a2 2 0 0 1 2 2v7l-9 9a2 2 0 0 1-2.8 0L3 14.8a2 2 0 0 1 0-2.8z"/><circle cx="16" cy="8" r="1.6"/>
    {%- when 'alert-triangle' -%}<path d="M12 3 2 20h20L12 3z"/><line x1="12" y1="10" x2="12" y2="14"/><line x1="12" y1="17" x2="12.01" y2="17"/>
    {%- when 'instagram' -%}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/>
    {%- when 'facebook' -%}<path d="M14 8.5V7a1.5 1.5 0 0 1 1.5-1.5H17V2.5h-2.5A4.5 4.5 0 0 0 10 7v1.5H7.5V12H10v9.5h4V12h2.6l.4-3.5z"/>
    {%- when 'tiktok' -%}<path d="M15 3.5c.6 2.3 2.1 3.7 4.5 3.9v3.2a7.6 7.6 0 0 1-4.3-1.4v5.9a6 6 0 1 1-6-6c.4 0 .7 0 1 .1v3.3a2.7 2.7 0 1 0 1.9 2.6V3.5z"/>
    {%- when 'youtube' -%}<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10.2 9.4l5 2.6-5 2.6z"/>
    {%- when 'bag' -%}<path d="M6 8h12l1 12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'leaf' -%}<path d="M20 4C10 4 4 10 4 18v2h2c8 0 14-6 14-16z"/><path d="M9 15c4-4 7-7 10-9"/>
  {%- endcase -%}
</svg>
