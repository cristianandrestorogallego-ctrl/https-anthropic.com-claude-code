<div class="cart-drawer__head">
  <strong>{{ 'cart.title' | t }}{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</strong>
  <button class="btn-icon" type="button" data-close-overlay aria-label="{{ 'cart.close' | t }}">
    {% render 'brand-icon', name: 'close', size: 20 %}
  </button>
</div>

<div class="cart-drawer__body">
  {%- if cart.item_count > 0 -%}
    {%- for item in cart.items -%}
      <div class="cart-line">
        <div class="cart-line__media{% unless item.image %} media-placeholder{% endunless %}" style="border-radius:var(--radius-sm);overflow:hidden">
          {%- if item.image -%}
            <img src="{{ item.image | image_url: width: 160 }}" alt="" width="160" height="160"
                 style="width:100%;height:100%;object-fit:cover">
          {%- else -%}
            {% render 'brand-icon', name: 'bag', size: 24 %}
          {%- endif -%}
        </div>
        <div>
          <div class="cart-line__name">{{ item.product.title }}</div>
          {%- unless item.product.has_only_default_variant -%}
            <div class="cart-line__meta">{{ item.variant.title }}</div>
          {%- endunless -%}
          <div class="cart-line__price tabular">{{ item.original_price | money }} × {{ item.quantity }}</div>
          <a class="cart-line__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
        </div>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="cart-empty">
      {% render 'brand-icon', name: 'cart', size: 48 %}
      <div>
        <strong>{{ 'cart.empty' | t }}</strong>
        <p style="margin-top:6px;font-size:.85rem">{{ 'cart.empty_help' | t }}</p>
      </div>
      <a class="btn btn-primary" href="{{ routes.all_products_collection_url }}" data-close-overlay>
        {{ 'collections.browse_all' | t }}
      </a>
    </div>
  {%- endif -%}
</div>

{%- if cart.item_count > 0 -%}
  <div class="cart-drawer__foot">
    <div class="cart-subtotal-row">
      <span>{{ 'cart.subtotal' | t }}</span>
      <span class="tabular">{{ cart.total_price | money }}</span>
    </div>
    <p class="cart-shipping-note">
      {% render 'brand-icon', name: 'truck', size: 14 %} {{ 'cart.shipping_note' | t }}
    </p>
    <form action="{{ routes.cart_url }}" method="post">
      <button class="btn btn-primary btn-block" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
    </form>
    <a class="btn btn-secondary btn-block" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
  </div>
{%- endif -%}
