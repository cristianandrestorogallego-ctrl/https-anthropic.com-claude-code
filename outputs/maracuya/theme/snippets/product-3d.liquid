{%- comment -%}
  Branded product render with real volume: lit from the upper left with a
  cylinder ramp across the body, a specular band, a rim light on the shaded
  edge, a blurred cast shadow and a label. Stands in for product photography
  until real photos exist — it is illustration, not a photograph.

  Usage: {% render 'product-3d', shape: 'jar', uid: block.id %}
{%- endcomment -%}
{%- liquid
  assign s = shape | default: 'jar'
  assign u = uid | default: s
-%}
<svg class="product-3d" viewBox="0 0 220 330" role="img" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="sh-{{ u }}" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#1B0E20" stop-opacity=".55"/>
      <stop offset="1" stop-color="#1B0E20" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="gl-{{ u }}" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0"/>
      <stop offset=".5" stop-color="#fff" stop-opacity=".55"/>
      <stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>
    {%- case s -%}
      {%- when 'jar' -%}
        <linearGradient id="b-{{ u }}" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#9C6B12"/><stop offset=".10" stop-color="#DFA326"/>
          <stop offset=".27" stop-color="#F6C445"/><stop offset=".46" stop-color="#DFA326"/>
          <stop offset=".80" stop-color="#9C6B12"/><stop offset=".95" stop-color="#9C6B12"/>
          <stop offset="1" stop-color="#DFA326"/>
        </linearGradient>
        <linearGradient id="l-{{ u }}" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#2C1030"/><stop offset=".10" stop-color="#4B204F"/>
          <stop offset=".27" stop-color="#6E4A72"/><stop offset=".46" stop-color="#4B204F"/>
          <stop offset=".80" stop-color="#2C1030"/><stop offset="1" stop-color="#4B204F"/>
        </linearGradient>
      {%- when 'bag' -%}
        <linearGradient id="b-{{ u }}" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#33220F"/><stop offset=".10" stop-color="#5E4129"/>
          <stop offset=".27" stop-color="#7E5B3C"/><stop offset=".46" stop-color="#5E4129"/>
          <stop offset=".80" stop-color="#33220F"/><stop offset="1" stop-color="#5E4129"/>
        </linearGradient>
      {%- when 'box' -%}
        <linearGradient id="f-{{ u }}" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#F3D9A8"/><stop offset=".55" stop-color="#E7C079"/><stop offset="1" stop-color="#D3A755"/>
        </linearGradient>
        <linearGradient id="sd-{{ u }}" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#A97F35"/><stop offset="1" stop-color="#8A6524"/>
        </linearGradient>
        <linearGradient id="t-{{ u }}" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#FBEBC8"/><stop offset="1" stop-color="#E4C384"/>
        </linearGradient>
      {%- when 'bottle' -%}
        <linearGradient id="b-{{ u }}" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#3E1943"/><stop offset=".10" stop-color="#7C3F82"/>
          <stop offset=".27" stop-color="#C489C9"/><stop offset=".46" stop-color="#7C3F82"/>
          <stop offset=".80" stop-color="#3E1943"/><stop offset="1" stop-color="#7C3F82"/>
        </linearGradient>
        <linearGradient id="c-{{ u }}" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#A87A12"/><stop offset=".27" stop-color="#F8D368"/>
          <stop offset=".60" stop-color="#E0B02E"/><stop offset="1" stop-color="#A87A12"/>
        </linearGradient>
    {%- endcase -%}
  </defs>

  {%- case s -%}
    {%- when 'jar' -%}
      <ellipse cx="110" cy="306" rx="74" ry="16" fill="url(#sh-{{ u }})"/>
      <rect x="60" y="120" width="100" height="176" rx="14" fill="url(#b-{{ u }})"/>
      <ellipse cx="110" cy="122" rx="50" ry="10" fill="#B9841C" opacity=".55"/>
      <rect x="72" y="150" width="76" height="92" rx="6" fill="#FFF8EC" opacity=".95"/>
      <rect x="72" y="150" width="76" height="20" fill="#4B204F"/>
      <text x="110" y="165" text-anchor="middle" font-family="Georgia,serif" font-size="12" fill="#FFF8EC">MARACUYA</text>
      <rect x="66" y="128" width="13" height="160" rx="6" fill="url(#gl-{{ u }})" opacity=".5"/>
      <rect x="62" y="96" width="96" height="34" rx="8" fill="url(#l-{{ u }})"/>
      <g opacity=".28" stroke="#1B0E20" stroke-width="1.5">
        <line x1="76" y1="102" x2="76" y2="124"/><line x1="90" y1="102" x2="90" y2="124"/>
        <line x1="104" y1="102" x2="104" y2="124"/><line x1="118" y1="102" x2="118" y2="124"/>
        <line x1="132" y1="102" x2="132" y2="124"/><line x1="146" y1="102" x2="146" y2="124"/>
      </g>
      <ellipse cx="110" cy="96" rx="48" ry="9" fill="#7A5480"/>
      <ellipse cx="110" cy="94" rx="40" ry="6" fill="#8E6494" opacity=".7"/>

    {%- when 'bag' -%}
      <ellipse cx="110" cy="308" rx="76" ry="15" fill="url(#sh-{{ u }})"/>
      <path d="M58 118 q52 -18 104 0 l10 176 q-62 16 -124 0z" fill="url(#b-{{ u }})"/>
      <path d="M58 118 q52 -18 104 0 l3 52 q-55 -14 -110 0z" fill="#1B0E20" opacity=".16"/>
      <rect x="74" y="176" width="72" height="96" rx="5" fill="#FFF8EC" opacity=".96"/>
      <rect x="74" y="176" width="72" height="22" fill="#4B204F"/>
      <text x="110" y="192" text-anchor="middle" font-family="Georgia,serif" font-size="12" fill="#FFF8EC">MARACUYA</text>
      <path d="M66 128 q8 -6 14 -7 l6 168 q-8 1 -14 3z" fill="url(#gl-{{ u }})" opacity=".45"/>
      <path d="M62 116 q48 -20 96 0 q-48 -8 -96 0z" fill="#8D6A49"/>
      <rect x="66" y="104" width="88" height="14" rx="4" fill="#4B204F"/>
      <rect x="66" y="104" width="88" height="5" rx="2.5" fill="#6E4A72" opacity=".8"/>

    {%- when 'box' -%}
      <ellipse cx="112" cy="300" rx="80" ry="16" fill="url(#sh-{{ u }})"/>
      <path d="M52 128 L140 108 L176 126 L176 262 L140 284 L52 264z" fill="url(#sd-{{ u }})"/>
      <path d="M140 108 L176 126 L176 262 L140 284z" fill="url(#sd-{{ u }})"/>
      <path d="M52 128 L140 108 L140 284 L52 264z" fill="url(#f-{{ u }})"/>
      <path d="M52 128 L140 108 L176 126 L88 146z" fill="url(#t-{{ u }})"/>
      <g transform="rotate(-6 97 209)">
        <rect x="66" y="166" width="62" height="86" rx="4" fill="#FFF8EC" opacity=".95"/>
        <rect x="66" y="166" width="62" height="20" fill="#4B204F"/>
        <text x="97" y="180" text-anchor="middle" font-family="Georgia,serif" font-size="10" fill="#FFF8EC">MARACUYA</text>
      </g>
      <path d="M52 128 L140 108 L140 284 L52 264z" fill="url(#gl-{{ u }})" opacity=".22"/>

    {%- when 'bottle' -%}
      <ellipse cx="110" cy="306" rx="66" ry="14" fill="url(#sh-{{ u }})"/>
      <path d="M86 84 h48 v26 q0 10 8 20 q14 18 14 42 v112 q0 12 -12 12 h-68 q-12 0 -12 -12 v-112 q0 -24 14 -42 q8 -10 8 -20z" fill="url(#b-{{ u }})"/>
      <rect x="70" y="196" width="80" height="74" rx="4" fill="#FFF8EC" opacity=".96"/>
      <rect x="70" y="196" width="80" height="20" fill="#4B204F"/>
      <text x="110" y="211" text-anchor="middle" font-family="Georgia,serif" font-size="12" fill="#FFF8EC">MARACUYA</text>
      <rect x="78" y="120" width="11" height="160" rx="5" fill="url(#gl-{{ u }})" opacity=".55"/>
      <g opacity=".22" stroke="#1B0E20" stroke-width="2">
        <line x1="88" y1="92" x2="132" y2="92"/><line x1="88" y1="100" x2="132" y2="100"/>
      </g>
      <rect x="84" y="58" width="52" height="30" rx="5" fill="url(#c-{{ u }})"/>
      <ellipse cx="110" cy="58" rx="26" ry="5" fill="#F8D368"/>
  {%- endcase -%}
</svg>
