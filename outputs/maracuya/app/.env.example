# Copia este archivo a .env.local y rellena los valores.
# .env.local está ignorado por git y nunca se sube al repositorio.

# Dominio .myshopify.com de la tienda.
VITE_SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com

# Token PÚBLICO de la Storefront API, el del canal Headless.
# Es público por diseño: viaja en el navegador y lo ve cualquier comprador.
# NUNCA pongas aquí el token privado (Shopify-Storefront-Private-Token):
# ese es secreto, es solo de servidor, y cualquier VITE_* acaba en el bundle.
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Versión de la API. Shopify publica una nueva cada trimestre.
VITE_SHOPIFY_API_VERSION=2025-10
